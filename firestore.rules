rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles & Subcollections (Strict Owner-Only Isolation)
    // Only the authenticated user can read, create, update, or delete their profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 1a. User's Close Contacts
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // 1b. User's AI and SafeChat history
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // 1c. User's Emergency Alerts
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }

      // 1d. Location Sharing Inbox (Receiving invites from contacts)
      match /inbox/{inboxId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // 2. Danger Zones
    // Authenticated users can read danger zones for active location monitoring
    // Authenticated users can report a new danger zone with required schema
    // Modifications/deletions are blocked for regular clients
    match /dangerzones/{zoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['lat', 'lng', 'radius', 'description']);
      allow update, delete: if false;
    }

    // 3. Safe Places (Police stations, hospitals)
    // Read-only for authenticated users, managed by backend/admin
    match /safe_places/{placeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 4. Backend & Administrative Collections
    // Managed exclusively by Firebase Admin SDK in backend (bypasses security rules)
    // Direct client SDK access is completely blocked
    match /client_mappings/{mappingId} {
      allow read, write: if false;
    }

    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    // 5. Default Deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
